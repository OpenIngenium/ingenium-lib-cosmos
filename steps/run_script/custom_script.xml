<?xml version='1.0' encoding='utf-8'?>
<custom-scripts>
    <header mission_name="COSMOS" />
    <custom_script description="Run a COSMOS script" hash="" script_id="" script_name="run_script" script_path="run_script.py" is_command="true">
        <script_entry display_value="script_name">
            <input_field description="Script name/path (e.g., SAMPLE/procedures/sample.py)" name="script_name" phase="AUTHORING" required="YES" type="STRING" />
            <input_field description="Wait for script completion (true/false)" name="wait_for_completion" phase="AUTHORING" required="YES" type="BOOL" default_value="true" />
            <input_field description="Timeout in seconds for script completion" name="timeout" phase="AUTHORING" required="NO" type="INT" default_value="300" />
            <output_field description="Script execution status message" name="status" type="STRING" />
            <output_field description="COSMOS script ID" name="script_id" type="STRING" />
            <output_field description="Script running state" name="running" type="STRING" />
            <output_field description="Script execution state" name="state" type="STRING" />
            <output_field description="Start Time" name="start_time" type="STRING" />
            <output_field description="End Time" name="end_time" type="STRING" />
            <output_field description="Timeout Remaining" name="timeout_remaining" type="INT"/>
            <output_field description="Current Line Number" name="cur_line_no" type="STRING" />
            <output_field description="Start Line Number" name="start_line_no" type="STRING" />
            <output_field description="End Line Number" name="end_line_no" type="STRING" />
            <output_field description="Last Update Time" name="last_update_time" type="STRING" />
        </script_entry>
        <advanced_layout>
            <entry_section>
                <section_header>
                    <layout_display>
                        <template template="Executing {script_name} Wait for Complete:{wait_for_completion} with timeout: {timeout}"></template>
                        <layout row="1" column="1" width="10" height="1" align="LEFT"></layout>
                    </layout_display>
                    <layout_display>
                        <template template="Script is state: {state} - Line number {cur_line_no} - Last Updated {last_update_time} - Timeout Remaining: {timeout_remaining}"></template>
                        <layout row="2" column="1" width="12" height="1" align="LEFT"></layout>
                    </layout_display>                   
                    <icon icon_type="STATUS">
                        <mouseover_display>
                            <mouseover_element field_name="status" display_name="Script Status"></mouseover_element>
                            <mouseover_element field_name="script_id" display_name="Script ID"></mouseover_element>
                            <mouseover_element field_name="running" display_name="Running"></mouseover_element>
                            <mouseover_element field_name="state" display_name="State"></mouseover_element>
                            <mouseover_element field_name="start_time" display_name="Start Time"></mouseover_element>
                            <mouseover_element field_name="end_time" display_name="End Time"></mouseover_element>
                            <mouseover_element field_name="last_update_time" display_name="Last Updated"></mouseover_element>
                            <mouseover_element field_name="cur_line_no" display_name="Current Line"></mouseover_element>
                            <mouseover_element field_name="start_line_no" display_name="Start Line"></mouseover_element>
                            <mouseover_element field_name="end_line_no" display_name="End Line"></mouseover_element>
                        </mouseover_display>
                        <layout row="1" column="12" width="1" height="1" align="RIGHT"></layout>
                    </icon>
                </section_header>
                <section_content>
                    <layout_field field_name="script_name">
                        <label label_content="Script Name/Path" label_loc="TOP" label_align="LEFT"></label>
                        <layout row="1" column="1" width="8" height="1" align="LEFT"></layout>
                    </layout_field>
                    <layout_field field_name="wait_for_completion">
                        <label label_content="Wait for Complete?" label_loc="TOP" label_align="CENTER"></label>
                        <layout row="1" column="9" width="2" height="1" align="CENTER"></layout>
                    </layout_field>
                    <layout_field field_name="timeout">
                        <label label_content="Timeout (s)" label_loc="TOP" label_align="CENTER"></label>
                        <layout row="1" column="11" width="2" height="1" align="RIGHT"></layout>
                    </layout_field>
                </section_content>
            </entry_section>
        </advanced_layout>
    </custom_script>
</custom-scripts>