<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="ingenium-lib/custom_script_schema.rnc" type="application/relax-ng-compact-syntax"?>
<custom-scripts>
    <header mission_name="COSMOS" />
    <custom_script description="Send commands to OpenC3 COSMOS via JSON-RPC API. " hash="" script_id="" script_name="send_command.py" script_path="send_command.py" is_command="true">
        <script_entry>
            <input_field description="Command String {Target}__{Command} with {ARG} {VALUE}..." name="command_string" phase="AUTHORING" required="YES" type="FLIGHT_COMMAND" />
            <input_field description="Command Checking" name="cmd_check" phase="AUTHORING" required="YES" type="ENUM" default_value="ENABLED">
                <enumeration>
                    <enum symbolic="NO_CHECK"></enum>
                    <enum symbolic="ENABLED"></enum>
                </enumeration>
            </input_field>
            <output_field description="Command Status" name="status" type="STRING" />          
            <output_field description="Command Count" name="cmd_cnt" type="INT" />
            <output_field description="Command Timestamp" name="timestamp" type="STRING" />
        </script_entry>
        <advanced_layout>
            <entry_section>
                <section_header>
                    <layout_display>
                        <template template="Send: {command_string} with Check: {cmd_check}"></template>
                        <layout row="1" column="1" width="10" height="1" align="LEFT"></layout>
                    </layout_display>
                    <icon icon_type="STATUS">
                        <mouseover_display>
                            <mouseover_element field_name="cmd_cnt" display_name="Command Count:"></mouseover_element>
                            <mouseover_element field_name="timestamp" display_name="Command Time:"/>
                        </mouseover_display>
                        <layout row="1" column="12" width="1" height="1" align="RIGHT"></layout>
                    </icon>
                </section_header>
                <section_content>
                    <layout_field field_name="command_string" tool_tip="String containing command using the format TGT__CMD with ARG_NAME ARG_VALUE,...">
                        <label label_content="Command String" label_loc="TOP" label_align="LEFT"></label>
                        <layout row="1" column="1" width="10" height="1" align="LEFT"></layout>
                    </layout_field>
                    <layout_field field_name="cmd_check" tool_tip="Enable or Disable Command Checking in Cosmos">
                        <label label_content="Check Command?" label_loc="TOP" label_align="LEFT"></label>
                        <layout row="1" column="11" width="2" height="1" align="RIGHT"></layout>
                    </layout_field>
                </section_content>
            </entry_section>
        </advanced_layout>
    </custom_script>
</custom-scripts>


